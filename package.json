{
  "name": "claude-motion",
  "version": "2.5.0",
  "private": true,
  "description": "High-performance 2D/3D motion graphics runtime, kinetic typography, and physics engine for deterministic 60 FPS video rendering.",
  "homepage": "https://theonlyfusioncube.github.io/claude-motion/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOnlyFusionCube/claude-motion.git"
  },
  "bugs": {
    "url": "https://github.com/TheOnlyFusionCube/claude-motion/issues"
  },
  "author": "Jesse Pan",
  "license": "MIT",
  "keywords": [
    "motion-graphics",
    "threejs",
    "creative-coding",
    "video-rendering",
    "physics-engine",
    "kinetic-typography",
    "playwright",
    "claude-code"
  ],
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify-upstream": "node scripts/sync-upstream.mjs --verify",
    "check": "node scripts/sync-upstream.mjs --verify && npm test",
    "check:example": "node scripts/check.mjs examples/launch",
    "preview": "node scripts/preview.mjs examples/launch",
    "export:example": "node scripts/export.mjs examples/launch --out examples/launch/film.mp4"
  }
}
